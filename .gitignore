# local env
.venv/
__pycache__/

# logs, and raw material imported from elsewhere. Neither is the record:
# the record is small, written by the clerk, and belongs on the host's
# disk; these are large, written by other things, and belong to nobody.
# A channel export in particular is everybody's messages, names and ids --
# it is fine to keep one to work from, and it is not fine to publish one.
logs/
raw/

