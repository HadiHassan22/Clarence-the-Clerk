# Copy this file to .env and fill in the token. That is the only required
# line; everything else has a working default.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# --- everything below is optional ---

# Optional, and it means "just this server, and now". Set it and his
# commands are registered to that guild alone and appear immediately;
# unset it and they are published globally to every server he is invited
# to, which Discord can take up to an hour to do. Never both: a command
# registered globally and to a guild shows up twice in that guild.
#
# If you are running him for one server, setting this is the better
# answer. If you want him to serve several, leave it out.
# GUILD_ID=123456789012345678

# Where state lives. Set this to a persistent disk when hosting
# (e.g. /data on Render), or leave it and state sits next to the code.
# Each server gets its own directory underneath.
# CLERK_DATA_DIR=/data

# The clerk's brain is NOT configured here. Each server brings its own
# key and sets it from inside Discord with `/setup`, choosing Gemini
# (Google AI Studio), Grok (console.x.ai) or Claude
# (console.anthropic.com) -- any of them, or several. That way somebody
# can run the clerk on their own server without touching a file, and one
# server's bill is never another's.
#
# A key set here is adopted, once, by every server he is already in the
# first time he starts. After that `/setup` is the way to change it.
# GEMINI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# The clerk needs the Message Content privileged intent to hear anyone,
# and asks for it by default. If you cannot enable it in the Developer
# Portal, set this to 0: the door and the votes all work, and he simply
# never speaks.
# CLERK_MESSAGE_CONTENT=1

# Defaults for a new install. A server can overrule either for itself.
# CLERK_BUDGET_USD=10
# CLERK_GEMINI_MODEL=gemini-3.1-flash-lite
# CLERK_GROK_MODEL=grok-4-fast
# CLERK_CLAUDE_MODEL=claude-opus-5
