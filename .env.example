# Copy this file to .env and fill in the values, or run `python3 install.py`
# and let it write this for you.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Your server's ID: enable Developer Mode in Discord settings,
# then right-click the server icon -> Copy Server ID
GUILD_ID=123456789012345678

# --- everything below is optional ---

# Where state lives. Set this to a persistent disk when hosting
# (e.g. /data on Render), or leave it and state sits next to the code.
# CLERK_DATA_DIR=/data

# The clerk's brain is NOT configured here. Each server brings its own
# key and sets it from inside Discord with `/setup brain`, choosing
# Gemini (Google AI Studio), Grok (console.x.ai) or Claude
# (console.anthropic.com) -- any of them, or several. That way a friend
# can run the clerk on their own server without touching a file.
#
# If you would rather set one here, the host's key is adopted by the
# server named in GUILD_ID the first time the clerk starts, and never
# read again. After that `/setup brain` is the way to change it.
# GEMINI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# The clerk needs the Message Content privileged intent to hear anyone,
# and asks for it by default. If you cannot enable it in the Developer
# Portal, set this to 0: the door, the floor and the roles all work, and
# he simply never speaks.
# CLERK_MESSAGE_CONTENT=1

# Defaults for a new install. A server can overrule either for itself.
# CLERK_BUDGET_USD=10
# CLERK_GEMINI_MODEL=gemini-3.1-flash-lite
# CLERK_GROK_MODEL=grok-4-fast
# CLERK_CLAUDE_MODEL=claude-opus-5
